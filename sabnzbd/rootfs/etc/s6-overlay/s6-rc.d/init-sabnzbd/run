#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: SABnzbd
# This files adds some patches to the app
# ==============================================================================
if ! bashio::fs.file_exists '/config/sabnzbd.ini'; then
    bashio::log.info "First run! Setting up some folders."
    mkdir -p \
        /media/sabnzbd/Downloads/complete \
        /media/sabnzbd/Downloads/incomplete
    ln -s /media/sabnzbd/Downloads /config/Downloads
    printf '[misc]\nurl_base = /sabnzbd\n' > /config/sabnzbd.ini
fi

# SABnzbd 4.4.0+ defaults url_base to empty, but Ingress serves it on /sabnzbd
if grep -q '^url_base = ""$' /config/sabnzbd.ini; then
    sed -i 's|^url_base = ""$|url_base = /sabnzbd|' /config/sabnzbd.ini
fi
